# Public application settings
UPLINK_COMMERCIAL_MODE=1
UPLINK_HOST=0.0.0.0
UPLINK_PORT=8800
UPLINK_PUBLIC_ORIGIN=https://app.example.com
UPLINK_TRUST_PROXY=1
